<?xml version="1.0" ?>
<!--
  ============================================================
  Agricultural Field World — Gazebo Harmony (Ionic)
  Project  : Autonomous Drone Monitoring
  Location : Jl. Aruman, Cimahi, West Java, Indonesia
  GPS Ref  : -6.8852 S, 107.5417 E  (WGS-84)
  Scale    : ~350 m x ~250 m
  Zones    :
    - MERAH (red)  : flat sawah, elevation Z = 0.00 m
    - BIRU  (blue) : terrain mudun, elevation Z = -1.50 m
  Author   : Gazebo Harmony / ROS2 Jazzy project
  SDF ver  : 1.9
  ============================================================
-->
<sdf version="1.9">
  <world name="agricultural_field">

    <!-- ======================================================
         PHYSICS
    ====================================================== -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Global wind configuration so it can be toggled in GUI -->
    <wind>
      <linear_velocity>1.5 1.5 0.0</linear_velocity>
    </wind>

    <!-- ======================================================
         PLUGINS (Gazebo Harmony / Ionic)
    ====================================================== -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-magnetometer-system"
            name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-particle-emitter-system"
            name="gz::sim::systems::ParticleEmitter"/>
    <plugin filename="gz-sim-wind-effects-system"
            name="gz::sim::systems::WindEffects">
      <force_approximation_scaling_factor>1</force_approximation_scaling_factor>
      <horizontal>
        <magnitude>
          <time_for_rise>10</time_for_rise>
          <sin>
            <amplitude_percent>0.05</amplitude_percent>
            <period>60</period>
          </sin>
          <noise type="gaussian">
           <mean>0</mean>
           <stddev>0.0002</stddev>
          </noise>
        </magnitude>
        <direction>
          <time_for_rise>30</time_for_rise>
          <sin>
            <amplitude>5</amplitude>
            <period>20</period>
          </sin>
          <noise type="gaussian">
           <mean>0</mean>
           <stddev>0.03</stddev>
          </noise>
        </direction>
      </horizontal>
      <vertical>
        <noise type="gaussian">
         <mean>0</mean>
         <stddev>0.03</stddev>
        </noise>
      </vertical>
    </plugin>

    <!-- ======================================================
         SCENE CONFIGURATION
    ====================================================== -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.6 0.78 0.95 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
    </scene>

    <!-- ======================================================
         GPS / SPHERICAL COORDINATES
         Referensi: Jl. Aruman, Cimahi, West Java
    ====================================================== -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>-6.8852</latitude_deg>
      <longitude_deg>107.5417</longitude_deg>
      <elevation>714</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- ======================================================
         ATMOSPHERIC / WIND
    ====================================================== -->
    <atmosphere type="adiabatic">
      <temperature>304</temperature>        <!-- ~31 degC (tropical) -->
      <pressure>93000</pressure>            <!-- ~714 m ASL -->
      <temperature_gradient>-0.0065</temperature_gradient>
    </atmosphere>

    <wind>
      <linear_velocity>1.5 0.5 0</linear_velocity>  <!-- gentle breeze N->E -->
    </wind>

    <!-- ======================================================
         SUN / DIRECTIONAL LIGHT
         Simulating ~10:00 WIB tropical sun
    ====================================================== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0.4 -0.8</pose>
      <diffuse>1.0 0.95 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <!-- Ambient fill light (sky) -->
    <light type="directional" name="sky_fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 50 0 -1.57 0</pose>
      <diffuse>0.4 0.5 0.65 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0 0 1</direction>
    </light>

    <!-- ======================================================
         GROUND BASE PLANE  (Z = 0)
         Covers the entire world — base layer
    ====================================================== -->
    <model name="ground_base">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.30 0.20 1</ambient>
            <diffuse>0.45 0.40 0.28 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================
         ZONA MERAH — LEFT BLOCK (Sawah Kiri)
         Ukuran : 220 m x 290 m  (X: -175 to 45, Y: -145 to 145)
         Elevation : Z = 0.00 m (flat)
    ====================================================== -->
    <model name="sawah_kiri">
      <static>true</static>
      <pose>-65 0 0 0 0 0</pose>
      <link name="link">
        <!-- Tanah sawah -->
        <visual name="soil">
          <geometry>
            <box><size>220 290 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.22 0.30 0.15 1</ambient>
            <diffuse>0.28 0.42 0.18 1</diffuse>
          </material>
        </visual>
        <collision name="col">
          <geometry>
            <box><size>220 290 0.1</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Pematang baris sawah kiri (paddy bunds) - tiap 1.8 m -->
    <!-- Generated 20 rows in Y direction, 0.15m tall -->
    <model name="pematang_kiri_group">
      <static>true</static>
      <pose>-65 0 0.05 0 0 0</pose>
      <link name="row_01"><visual name="v"><pose>0 -135 0.075 0 0 0</pose><geometry><box><size>218 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="row_02"><visual name="v"><pose>0 -117 0.075 0 0 0</pose><geometry><box><size>218 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="row_03"><visual name="v"><pose>0 -99 0.075 0 0 0</pose><geometry><box><size>218 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="row_04"><visual name="v"><pose>0 -81 0.075 0 0 0</pose><geometry><box><size>218 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="row_05"><visual name="v"><pose>0 -63 0.075 0 0 0</pose><geometry><box><size>218 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="row_06"><visual name="v"><pose>0 -45 0.075 0 0 0</pose><geometry><box><size>218 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="row_07"><visual name="v"><pose>0 -27 0.075 0 0 0</pose><geometry><box><size>218 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="row_08"><visual name="v"><pose>0  -9 0.075 0 0 0</pose><geometry><box><size>218 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="row_09"><visual name="v"><pose>0   9 0.075 0 0 0</pose><geometry><box><size>218 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="row_10"><visual name="v"><pose>0  27 0.075 0 0 0</pose><geometry><box><size>218 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="row_11"><visual name="v"><pose>0  45 0.075 0 0 0</pose><geometry><box><size>218 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="row_12"><visual name="v"><pose>0  63 0.075 0 0 0</pose><geometry><box><size>218 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="row_13"><visual name="v"><pose>0  81 0.075 0 0 0</pose><geometry><box><size>218 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="row_14"><visual name="v"><pose>0  99 0.075 0 0 0</pose><geometry><box><size>218 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="row_15"><visual name="v"><pose>0 117 0.075 0 0 0</pose><geometry><box><size>218 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="row_16"><visual name="v"><pose>0 135 0.075 0 0 0</pose><geometry><box><size>218 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
    </model>

    <!-- Air genangan sawah kiri (water layer, semi-transparent) -->
    <model name="air_sawah_kiri">
      <static>true</static>
      <pose>-65 0 0.04 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry>
            <box><size>218 288 0.02</size></box>
          </geometry>
          <material>
            <ambient>0.10 0.25 0.45 0.55</ambient>
            <diffuse>0.12 0.30 0.55 0.55</diffuse>
            <specular>0.80 0.80 0.80 0.55</specular>
          </material>
          <transparency>0.45</transparency>
        </visual>
      </link>
    </model>

    <!-- ======================================================
         ZONA MERAH — TOP-RIGHT BLOCK (Sawah Kanan Atas)
         Ukuran : 280 m x 175 m  (X: 45 to 325, Y: -87 to 88)
         Elevation : Z = 0.00 m
    ====================================================== -->
    <model name="sawah_kanan_atas">
      <static>true</static>
      <pose>185 0 0 0 0 0</pose>
      <link name="link">
        <visual name="soil">
          <geometry>
            <box><size>280 175 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.22 0.30 0.15 1</ambient>
            <diffuse>0.28 0.42 0.18 1</diffuse>
          </material>
        </visual>
        <collision name="col">
          <geometry>
            <box><size>280 175 0.1</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Pematang sawah kanan atas -->
    <model name="pematang_kanan_atas">
      <static>true</static>
      <pose>185 0 0.05 0 0 0</pose>
      <link name="r1"><visual name="v"><pose>0 -72 0.075 0 0 0</pose><geometry><box><size>278 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="r2"><visual name="v"><pose>0 -54 0.075 0 0 0</pose><geometry><box><size>278 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="r3"><visual name="v"><pose>0 -36 0.075 0 0 0</pose><geometry><box><size>278 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="r4"><visual name="v"><pose>0 -18 0.075 0 0 0</pose><geometry><box><size>278 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="r5"><visual name="v"><pose>0   0 0.075 0 0 0</pose><geometry><box><size>278 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="r6"><visual name="v"><pose>0  18 0.075 0 0 0</pose><geometry><box><size>278 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="r7"><visual name="v"><pose>0  36 0.075 0 0 0</pose><geometry><box><size>278 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="r8"><visual name="v"><pose>0  54 0.075 0 0 0</pose><geometry><box><size>278 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="r9"><visual name="v"><pose>0  72 0.075 0 0 0</pose><geometry><box><size>278 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
    </model>

    <!-- Air genangan sawah kanan atas -->
    <model name="air_sawah_kanan_atas">
      <static>true</static>
      <pose>185 0 0.04 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry>
            <box><size>278 173 0.02</size></box>
          </geometry>
          <material>
            <ambient>0.10 0.25 0.45 0.55</ambient>
            <diffuse>0.12 0.30 0.55 0.55</diffuse>
            <specular>0.80 0.80 0.80 0.55</specular>
          </material>
          <transparency>0.45</transparency>
        </visual>
      </link>
    </model>

    <!-- ======================================================
         ZONA MERAH — BOTTOM-MIDDLE BLOCK (Sawah Tengah Bawah)
         Ukuran : 170 m x 115 m
         Elevation : Z = 0.00 m
    ====================================================== -->
    <model name="sawah_tengah_bawah">
      <static>true</static>
      <pose>130 -144 0 0 0 0</pose>
      <link name="link">
        <visual name="soil">
          <geometry>
            <box><size>170 115 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.22 0.30 0.15 1</ambient>
            <diffuse>0.28 0.42 0.18 1</diffuse>
          </material>
        </visual>
        <collision name="col">
          <geometry>
            <box><size>170 115 0.1</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Pematang sawah tengah bawah -->
    <model name="pematang_tengah_bawah">
      <static>true</static>
      <pose>130 -144 0.05 0 0 0</pose>
      <link name="r1"><visual name="v"><pose>0 -45 0.075 0 0 0</pose><geometry><box><size>168 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="r2"><visual name="v"><pose>0 -27 0.075 0 0 0</pose><geometry><box><size>168 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="r3"><visual name="v"><pose>0  -9 0.075 0 0 0</pose><geometry><box><size>168 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="r4"><visual name="v"><pose>0   9 0.075 0 0 0</pose><geometry><box><size>168 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="r5"><visual name="v"><pose>0  27 0.075 0 0 0</pose><geometry><box><size>168 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
      <link name="r6"><visual name="v"><pose>0  45 0.075 0 0 0</pose><geometry><box><size>168 0.4 0.15</size></box></geometry><material><ambient>0.30 0.40 0.20 1</ambient><diffuse>0.35 0.50 0.25 1</diffuse></material></visual></link>
    </model>

    <!-- ======================================================
         ZONA BIRU — TERRAIN MUDUN (Lower Ground)
         Ukuran : 140 m x 115 m
         Center : X=285, Y=-144
         Elevation dasar : Z = -1.50 m
         Slope transisi : ~5 deg dari zona merah
    ====================================================== -->
    <!-- Terrain dasar (lowered) -->
    <model name="terrain_biru_dasar">
      <static>true</static>
      <pose>285 -144 -1.5 0 0 0</pose>
      <link name="link">
        <visual name="soil">
          <geometry>
            <box><size>140 115 0.3</size></box>
          </geometry>
          <material>
            <ambient>0.18 0.26 0.12 1</ambient>
            <diffuse>0.22 0.34 0.15 1</diffuse>
          </material>
        </visual>
        <collision name="col">
          <geometry>
            <box><size>140 115 0.3</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Slope/tepi transisi BIRU — sisi kiri (X=215, slope menghadap kiri) -->
    <model name="slope_biru_kiri">
      <static>true</static>
      <pose>218 -144 -0.75 0 0.0873 0</pose>
      <!-- pitch = atan(1.5/10) ~= 0.0873 rad = ~5 deg -->
      <link name="link">
        <visual name="v">
          <geometry>
            <box><size>12 115 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.30 0.28 0.20 1</ambient>
            <diffuse>0.38 0.36 0.25 1</diffuse>
          </material>
        </visual>
        <collision name="col">
          <geometry>
            <box><size>12 115 0.1</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Slope BIRU — sisi atas (Y=-87, slope menghadap atas) -->
    <model name="slope_biru_atas">
      <static>true</static>
      <pose>285 -87 -0.75 -0.0873 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry>
            <box><size>140 12 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.30 0.28 0.20 1</ambient>
            <diffuse>0.38 0.36 0.25 1</diffuse>
          </material>
        </visual>
        <collision name="col">
          <geometry>
            <box><size>140 12 0.1</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Pematang di zona biru -->
    <model name="pematang_biru">
      <static>true</static>
      <pose>285 -144 -1.45 0 0 0</pose>
      <link name="r1"><visual name="v"><pose>0 -40 0.075 0 0 0</pose><geometry><box><size>138 0.4 0.15</size></box></geometry><material><ambient>0.25 0.35 0.15 1</ambient><diffuse>0.30 0.45 0.20 1</diffuse></material></visual></link>
      <link name="r2"><visual name="v"><pose>0 -20 0.075 0 0 0</pose><geometry><box><size>138 0.4 0.15</size></box></geometry><material><ambient>0.25 0.35 0.15 1</ambient><diffuse>0.30 0.45 0.20 1</diffuse></material></visual></link>
      <link name="r3"><visual name="v"><pose>0   0 0.075 0 0 0</pose><geometry><box><size>138 0.4 0.15</size></box></geometry><material><ambient>0.25 0.35 0.15 1</ambient><diffuse>0.30 0.45 0.20 1</diffuse></material></visual></link>
      <link name="r4"><visual name="v"><pose>0  20 0.075 0 0 0</pose><geometry><box><size>138 0.4 0.15</size></box></geometry><material><ambient>0.25 0.35 0.15 1</ambient><diffuse>0.30 0.45 0.20 1</diffuse></material></visual></link>
      <link name="r5"><visual name="v"><pose>0  40 0.075 0 0 0</pose><geometry><box><size>138 0.4 0.15</size></box></geometry><material><ambient>0.25 0.35 0.15 1</ambient><diffuse>0.30 0.45 0.20 1</diffuse></material></visual></link>
    </model>

    <!-- Air genangan zona biru -->
    <model name="air_sawah_biru">
      <static>true</static>
      <pose>285 -144 -1.47 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry>
            <box><size>138 113 0.02</size></box>
          </geometry>
          <material>
            <ambient>0.08 0.22 0.42 0.60</ambient>
            <diffuse>0.10 0.28 0.52 0.60</diffuse>
            <specular>0.85 0.85 0.85 0.60</specular>
          </material>
          <transparency>0.40</transparency>
        </visual>
      </link>
    </model>

    <!-- ======================================================
         SALURAN IRIGASI UTAMA (Main Irrigation Channels)
         Lebar 1.2 m, Kedalaman 0.4 m
    ====================================================== -->
    <!-- Channel vertikal (N-S) - memisahkan blok kiri dan kanan -->
    <model name="irigasi_ns_1">
      <static>true</static>
      <pose>45 0 -0.15 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry>
